+bool TreeModel::removeItem(TreeModelItem *item)
+{
+    int index = m_items.indexOf(item);
+    if (index >= 0)
+    {
+        beginRemoveRows(QModelIndex(), index, index);
+        // Only folders are indexed by path. A leaf can share their label.
+        for (auto it = m_itemsPathMap.begin(); it != m_itemsPathMap.end();)
+        {
+            if (it.value() == item)
+                it = m_itemsPathMap.erase(it);
+            else
+                ++it;
+        }
+        m_items.removeAt(index);
+        delete item;
+        endRemoveRows();
+        return true;
+    }
+
+    for (TreeModelItem *child : m_items)
+    {
+        if (child->hasChildren() && child->children()->removeItem(item))
+            return true;
+    }
+    return false;
+}
