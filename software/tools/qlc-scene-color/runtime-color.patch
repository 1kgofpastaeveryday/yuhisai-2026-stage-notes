+namespace { std::atomic<quint32> globalFadeTimes{0xffffffffu}; }
+
+void Function::setGlobalFadeOverride(int fadeInMs, int fadeOutMs)
+{
+    if (fadeInMs < -1 || fadeInMs > 1000 || fadeOutMs < -1 || fadeOutMs > 1000)
+        return;
+    const quint32 in = fadeInMs < 0 ? 0xffffu : quint32(fadeInMs);
+    const quint32 out = fadeOutMs < 0 ? 0xffffu : quint32(fadeOutMs);
+    globalFadeTimes.store((in << 16) | out);
+}
+
+int Function::globalFadeInOverride()
+{
+    const quint32 value = globalFadeTimes.load() >> 16;
+    return value == 0xffffu ? -1 : int(value);
+}
+
+int Function::globalFadeOutOverride()
+{
+    const quint32 value = globalFadeTimes.load() & 0xffffu;
+    return value == 0xffffu ? -1 : int(value);
+}
+
 uint Function::overrideFadeInSpeed() const
 {
     return m_overrideFadeInSpeed;
