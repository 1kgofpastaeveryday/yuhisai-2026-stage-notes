@@ -221,6 +231,21 @@ quint32 VCButton::functionID() const
     return m_functionID;
 }
 
+void VCButton::slotFunctionNameChanged(quint32 fid)
+{
+    if (fid != m_functionID)
+        return;
+
+    // Caption changes are recorded with the rename. During undo/redo or
+    // network replay, replay those recorded captions instead, so that undo
+    // also restores a caption that was customized before the rename.
+    if (Tardis::instance() && Tardis::instance()->isReplaying())
+        return;
+
+    if (Function *function = m_doc->function(fid))
+        setCaption(function->name());
+}
